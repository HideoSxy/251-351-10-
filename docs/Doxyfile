# StegoApp — запуск из корня репозитория:
#   doxygen docs/Doxyfile

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "StegoApp"
PROJECT_BRIEF          = "TCP server: auth, SHA-384, chord, steganography"
OUTPUT_DIRECTORY       = docs/doxygen-html
OUTPUT_LANGUAGE        = Russian

MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = YES
BUILTIN_STL_SUPPORT    = YES

INPUT                  = docs/mainpage.md \
                         backend_server \
                         main.cpp \
                         mainwindow.h \
                         mainwindow.cpp
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.cpp *.h *.md
RECURSIVE              = YES
EXCLUDE                = backend_server/build
EXCLUDE_PATTERNS       = */build/* \
                         */CMakeFiles/* \
                         *moc_*.cpp \
                         *mocs_compilation.cpp \
                         */CompilerIdCXX/*

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

SOURCES_BROWSER        = YES
REFERENCES_LINK_SOURCE = YES
SOURCE_TOOLTIPS        = YES
INLINE_SOURCES         = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
HAVE_DOT               = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
QUIET                  = NO
